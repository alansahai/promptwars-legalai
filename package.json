{
  "name": "legal-ai-poc",
  "version": "1.0.0",
  "description": "AI-powered legal document analysis platform (Gemini API)",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx watch src/api/server.ts",
    "build": "next build",
    "start": "next start",
    "start:server": "tsx src/api/server.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
    "lint": "eslint src pages",
    "lint:fix": "eslint src pages --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"pages/**/*.{ts,tsx}\" \"*.json\" \"*.md\"",
    "type-check": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/cors": "^2.8.17",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "typescript": "^7.0.2",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.3.2",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-axe": "^11.0.0",
    "@types/jest-axe": "^3.5.9",
    "ts-jest": "^29.2.2",
    "supertest": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "postcss": "^8.4.39",
    "autoprefixer": "^10.4.19",
    "tsx": "^4.16.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  }
}
